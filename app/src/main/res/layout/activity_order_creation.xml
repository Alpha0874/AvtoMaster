<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Создание заказа"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <!-- Контактные данные -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Контактные данные"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/editClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя заказчика"
            android:inputType="textPersonName"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent" />
        <EditText
            android:id="@+id/editClientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Телефон"
            android:inputType="phone"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="8dp" />

        <!-- Адрес -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Адрес"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
        <Spinner
            android:id="@+id/spinnerCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/editAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Улица, дом"
            android:inputType="textPostalAddress"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutMkadDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <EditText
                android:id="@+id/editDistanceMkad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Километров за МКАД"
                android:inputType="number"
                android:text="0"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/orange_accent" />
        </LinearLayout>

        <!-- Транспорт -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Транспортное средство"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/editVehicleBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Марка"
            android:inputType="text"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent" />
        <EditText
            android:id="@+id/editVehicleModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Модель"
            android:inputType="text"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent" />
        <EditText
            android:id="@+id/editVehicleYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Год выпуска"
            android:inputType="number"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent" />
        <Spinner
            android:id="@+id/spinnerVehicleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Описание -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Описание проблемы"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/editProblemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Что случилось?"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent" />

        <EditText
            android:id="@+id/editComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Комментарий к заказу (необязательно)"
            android:inputType="text"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="8dp" />

        <!-- Способ оплаты -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Способ оплаты"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
        <Spinner
            android:id="@+id/spinnerPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Цена -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цена (руб)"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/editPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="number"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent" />

        <!-- Цена по договорённости -->
        <CheckBox
            android:id="@+id/checkPriceByAgreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цена по договорённости"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <!-- Кнопка продолжения -->
        <Button
            android:id="@+id/buttonContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Продолжить"
            android:backgroundTint="@color/orange_accent"
            android:textColor="@color/background_dark"
            android:padding="12dp"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>