<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/orange_accent"
        android:titleTextColor="@color/white"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Информация о мастере"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/orange_accent"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/textEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ФИО:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/editFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ФИО"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/orange_accent"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Никнейм:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/editNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Никнейм"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/orange_accent"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Телефон:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/editPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Телефон"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/orange_accent"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Город:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/editCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Город"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/orange_accent"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Статус верификации:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/textVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/buttonVerify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Подтвердить"
                    android:backgroundTint="@color/switch_thumb_on"
                    android:textColor="@color/background_dark"
                    android:layout_marginEnd="8dp" />
                <Button
                    android:id="@+id/buttonReject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Отклонить"
                    android:backgroundTint="@color/switch_thumb_off"
                    android:textColor="@color/background_dark" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Роль:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/textRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Статус мастера:"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/textMasterStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сохранить изменения"
                android:backgroundTint="@color/orange_accent"
                android:textColor="@color/background_dark"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/buttonDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Удалить мастера"
                android:backgroundTint="@color/switch_thumb_off"
                android:textColor="@color/background_dark"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>