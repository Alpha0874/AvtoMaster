<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Приветствие -->
        <TextView
            android:id="@+id/textWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Здравствуйте, Мастер!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Количество новых заказов -->
        <TextView
            android:id="@+id/textNewOrdersCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Новых заказов: 0"
            android:textSize="18sp"
            android:textColor="#FF9800"
            android:layout_marginBottom="16dp" />

        <!-- Переключатель приёма заказов -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Принимать заказы"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAcceptingOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#FF9800"
                android:trackTint="#555555" />
        </LinearLayout>

        <!-- Кнопки "Новые заказы" и "Мои заказы" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnNewOrders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Новые заказы"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnMyOrders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Мои заказы"
                android:backgroundTint="#2A2A2A"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Кнопки "Форум" и "Статистика" (добавлены) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnForum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Форум"
                android:backgroundTint="#2A2A2A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnStatistics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Статистика"
                android:backgroundTint="#2A2A2A"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Кнопка "Профиль" -->
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Профиль"
            android:backgroundTint="#2A2A2A"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Кнопка "Администрирование" (видна только админу) -->
        <Button
            android:id="@+id/btnAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Администрирование"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Статистика выполненных заказов -->
        <TextView
            android:id="@+id/textCompletedOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Выполнено заказов: 0"
            android:textSize="16sp"
            android:textColor="#B0B0B0"
            android:layout_marginBottom="8dp" />

        <!-- Версия приложения -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Версия 1.0.0"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>