<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <ListView
        android:id="@+id/listChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Нижняя панель ввода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/card_dark"
        android:elevation="4dp">

        <EditText
            android:id="@+id/editChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Сообщение..."
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/input_background"
            android:maxLines="5"
            android:inputType="textMultiLine"
            android:layout_marginEnd="8dp" />

        <!-- Кнопка прикрепить фото/камера -->
        <Button
            android:id="@+id/buttonAttach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="📷"
            android:textSize="22sp"
            android:textColor="@color/orange_accent"
            android:background="@android:color/transparent"
            android:layout_marginEnd="8dp"
            android:padding="0dp"
            android:gravity="center" />

        <!-- Кнопка отправить (AppCompatButton, backgroundTint=null) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Отправить"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/button_green_rounded"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>