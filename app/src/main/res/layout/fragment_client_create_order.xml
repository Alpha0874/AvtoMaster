<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Услуга"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Адрес"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Улица, дом"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Описание проблемы"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Кратко опишите проблему"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:minLines="3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип ТС"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerVehicleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Марка"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editVehicleBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Toyota"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Модель"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editVehicleModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Camry"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Год выпуска"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editVehicleYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2020"
            android:inputType="number"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <!-- Расстояние за городом (км) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Расстояние за городом (км)"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="number"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цена (руб)"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0 (если договорная)"
            android:inputType="number"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ваше имя"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Иванов Иван"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Телефон"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editClientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="89991234567"
            android:inputType="phone"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Город"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Москва"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Способ оплаты"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonCreateOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Создать заказ"
            android:backgroundTint="@color/orange_accent"
            android:textColor="@color/background_dark"
            android:padding="12dp"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>