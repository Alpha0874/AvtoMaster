<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Аватар -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imageAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@android:drawable/ic_menu_edit"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_border"
                android:padding="4dp"
                android:contentDescription="@null" />

            <Button
                android:id="@+id/buttonChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сменить аватар"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Поля ввода (используем простой фон через shape) -->
        <EditText
            android:id="@+id/editFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Полное имя *"
            android:textColorHint="#B0B0B0"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/editNickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Никнейм *"
            android:textColorHint="#B0B0B0"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/editServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название сервиса"
            android:textColorHint="#B0B0B0"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/editPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Телефон *"
            android:textColorHint="#B0B0B0"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="phone" />

        <EditText
            android:id="@+id/editCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Город *"
            android:textColorHint="#B0B0B0"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/editExperienceYears"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Опыт работы (лет) *"
            android:textColorHint="#B0B0B0"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="number" />

        <!-- Готовность к корпоративным заказам -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Готовность к корпоративным заказам"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupCorporate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioCorporateYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Да"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioCorporateNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет"
                android:textColor="#FFFFFF"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <!-- Кнопка сохранения -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Кнопки выхода и информации -->
        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выйти из аккаунта"
            android:backgroundTint="#2A2A2A"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/buttonAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Информация о приложении"
            android:backgroundTint="#2A2A2A"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>