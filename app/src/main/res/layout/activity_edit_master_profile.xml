<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Аватар -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imageAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_role_master"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/avatar" />

            <Button
                android:id="@+id/buttonChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сменить аватар"
                style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>

        <!-- ФИО -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Фамилия, Имя, Отчество"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Иванов Иван Иванович"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <!-- Никнейм -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Никнейм (отображаемое имя)"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editNickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Юрий"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <!-- Название сервиса -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Название автосервиса (если есть)"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AMG service"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <!-- Телефон -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Номер телефона"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="89932908749"
            android:inputType="phone"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <!-- Город -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Город"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/editCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Краснодар"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/orange_accent"
            android:layout_marginBottom="16dp" />

        <!-- Готов к корпоративным клиентам -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Готов выполнять заказы корпоративных клиентов?"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />
        <RadioGroup
            android:id="@+id/radioGroupCorporate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/radioCorporateYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Да"
                android:textColor="@color/text_primary" />
            <RadioButton
                android:id="@+id/radioCorporateNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <!-- Статус мастера -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус мастера"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Наличие сканера -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Наличие специального оборудования (сканеров)"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />
        <RadioGroup
            android:id="@+id/radioGroupEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <RadioButton
                android:id="@+id/radioEquipmentYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Есть"
                android:textColor="@color/text_primary" />
            <RadioButton
                android:id="@+id/radioEquipmentNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Подтверждение личности"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/orange_accent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/textVerificationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус: не проверен"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/buttonUploadPassport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Загрузить фото паспорта"
            android:backgroundTint="@color/orange_accent"
            android:textColor="#1E1E1E"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Требуется фото разворота. После проверки администратором откроется доступ к форуму и заказам."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- Кнопка сохранения -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:backgroundTint="@color/orange_accent"
            android:textColor="#1E1E1E"
            android:padding="12dp"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>